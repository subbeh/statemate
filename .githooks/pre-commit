#!/usr/bin/env bash
#
# Two guards on commits that change user-visible behavior:
#   1. a CHANGELOG.md entry is present
#   2. docs/commands/ matches the current help text
#
# Rationale: both were repeatedly forgotten. CHANGELOG entries had to be
# backfilled from git log, and the generated command reference drifted far enough
# to document commands that no longer existed.
#
# Bypass for genuinely non-user-facing changes (internal refactors, tests):
#   git commit --no-verify

set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Only care about changes to actual program code.
code_changed=$(printf '%s\n' "$staged" | grep -E '^(internal|cmd)/' || true)

# Test-only changes don't need a CHANGELOG entry.
non_test_code=$(printf '%s\n' "$code_changed" | grep -v '_test\.go$' || true)

if [ -z "$non_test_code" ]; then
  exit 0
fi

fail() {
  cat >&2
  exit 1
}

# --- 1. CHANGELOG ------------------------------------------------------------

if ! printf '%s\n' "$staged" | grep -qx 'CHANGELOG.md'; then
  {
    cat <<'EOF'
✗ Commit blocked: CHANGELOG.md not updated

Staged changes touch internal/ or cmd/ but CHANGELOG.md is not staged.
Add an entry under [Unreleased], written from the user's perspective:

  ### Fixed
  - `mate clean` now uses sudo to remove files requiring elevated access

Then stage it:

  git add CHANGELOG.md

If this change is genuinely not user-facing (internal refactor, tests only):

  git commit --no-verify

Staged code files:
EOF
    printf '%s\n' "$non_test_code" | sed 's/^/  /'
  } | fail
fi

# --- 2. Generated command reference -----------------------------------------

# Only worth checking when the CLI definitions changed; regenerating costs a `go
# run`, and nothing else feeds docs/commands/.
cli_changed=$(printf '%s\n' "$non_test_code" | grep -E '^(internal/cli/|cmd/gendocs/)' || true)

if [ -n "$cli_changed" ]; then
  if ! make docs >/dev/null 2>&1; then
    echo "⚠ Skipping docs check: 'make docs' failed" >&2
    exit 0
  fi

  if ! git diff --quiet -- docs/commands/ || \
     [ -n "$(git ls-files --others --exclude-standard docs/commands/)" ]; then
    {
      cat <<'EOF'
✗ Commit blocked: docs/commands/ is out of date

Command help text changed, so the generated reference no longer matches. It has
just been regenerated for you -- stage it:

  git add docs/commands

If the help text change was unintentional, revert it instead.
EOF
    } | fail
  fi
fi
